# Copy to .env and fill in. Never commit .env (it is git-ignored).
DIDIT_API_KEY=your-didit-api-key-here
PORT=8080
DIDIT_API_BASE=https://verification.didit.me
UPSTREAM_TIMEOUT_MS=1500
UPSTREAM_WRITE_TIMEOUT_MS=5000
UPSTREAM_MAX_BODY_BYTES=8388608
MEDIA_CACHE_DIR=./.cache/media
# Media re-serving (Phase 2). Rewriting is active only when DIDIT_MEDIA_HOSTS
# and PUBLIC_MEDIA_BASE are both set; otherwise responses pass through.
DIDIT_MEDIA_HOSTS=
PUBLIC_MEDIA_BASE=
MEDIA_LINK_TTL_MS=1800000
MEDIA_CACHE_ENABLED=true
MEDIA_SIGNING_SECRET=
MEDIA_CACHE_MAX_BYTES=268435456
LOG_LEVEL=info
NODE_ENV=development
SHUTDOWN_TIMEOUT_MS=10000
